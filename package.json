{
  "name": "dosword",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "面向授权安全测试的现代化 WebShell 管理客户端（Tauri 2 + React 19 + Rust）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lin9527ya/DoSword.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "lint": "eslint .",
    "gen:types": "cargo test -p dosword-sdk --lib generate_ts_bindings",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.4"
  },
  "packageManager": "pnpm@11.21.0"
}
